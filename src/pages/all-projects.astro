---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { parseWorkBlocks } from '../lib/parseWorkBody';

const allWorks = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const allWorksWithBlocks = allWorks.map((work) => ({
  work,
  blocks: parseWorkBlocks(work.body ?? ''),
}));
---

<Layout
  title="All Works | huraru's Portfolio"
  description="huraru の全作品アーカイブ"
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/skill.css">
    <link rel="stylesheet" href="/css/modal.css">
    <link rel="stylesheet" href="/css/works.css">
    <link rel="stylesheet" href="/css/media.css">

    <script src="/js/dotMotion.js" defer></script>
    <script src="/js/Theme.js" defer></script>
    <script src="/js/Modal.js" defer></script>
    <script src="/js/tag-filter.js" defer></script>
  </Fragment>

  <header>
    <nav>
      <a href="index.html" class="logo">PORTFOLIO</a>
      <ul class="nav-links" id="navLinks">
        <li><a href="index.html">TOP</a></li>
        <li><a href="index.html#about">ABOUT</a></li>
        <li><a href="index.html#featured-works">WORKS</a></li>
        <li><a href="index.html#skill">SKILL</a></li>
      </ul>
      <div class="nav-actions">
        <button class="hamburger" id="hamburger" aria-label="メニューを開く">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
        <button id="theme-toggle" class="theme-toggle">
          <span class="icon sun">☀</span>
          <span class="icon moon">🌙</span>
        </button>
      </div>
    </nav>
  </header>

  <section class="section" id="projects">
    <div class="container">
      <h2 class="section-title">ALL WORKS</h2>

      <div class="tag-filter" id="tagFilter"></div>

      <div class="project-grid" id="projectGrid">
        {allWorksWithBlocks.map(({ work, blocks }) => (
          <ProjectCard work={work} blocks={blocks} />
        ))}
      </div>
    </div>
  </section>

  <footer id="contact">
    <p class="footer-text">
      CONTACT: <span class="footer-email">hurarunium@gmail.com</span>
    </p>
    <p class="footer-copyright">
      2025 this portfolio is designed by huraru.
    </p>
  </footer>
</Layout>
