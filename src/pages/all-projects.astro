---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { parseWorkBlocks } from '../lib/parseWorkBody';
import '../styles/main.css';
import '../styles/skill.css';
import '../styles/modal.css';
import '../styles/works.css';
import '../styles/media.css';

const allWorks = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const allWorksWithBlocks = allWorks.map((work) => ({
  work,
  blocks: parseWorkBlocks(work.body ?? ''),
}));
---

<Layout
  title="All Works | huraru's Portfolio"
  description="huraru の全作品アーカイブ"
>
  <Fragment slot="head">
    <script>
      import '../scripts/dotMotion.js';
      import '../scripts/theme.js';
      import '../scripts/modal.js';
      import '../scripts/tagFilter.js';
    </script>
  </Fragment>

  <section class="section" id="projects">
    <div class="container">
      <h2 class="section-title">ALL WORKS</h2>

      <div class="tag-filter" id="tagFilter"></div>

      <div class="project-grid" id="projectGrid">
        {allWorksWithBlocks.map(({ work, blocks }) => (
          <ProjectCard work={work} blocks={blocks} />
        ))}
      </div>
    </div>
  </section>

</Layout>
