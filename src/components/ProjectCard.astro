---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { WorkBlock } from '../lib/parseWorkBody';
import { getCardExcerpt } from '../lib/parseWorkBody';
import { resolveWorkImage } from '../lib/resolveWorkImage';

interface Props {
  work: CollectionEntry<'works'>;
  blocks: WorkBlock[];
}

const { work, blocks } = Astro.props;
const excerpt = getCardExcerpt(work.data.summary, blocks);
const optimizedImage = resolveWorkImage(work.data.image);
const fallbackImageSrc = work.data.image ? `/${work.data.image.replace(/^\/+/, '')}` : '';
---

<a
  href={`/works/${work.id}.html`}
  class="work-card project-card"
  data-tags={work.data.tags.join(',')}
>
  {optimizedImage ? (
    <div class="project-media">
      <Image src={optimizedImage} alt={work.data.title} />
    </div>
  ) : fallbackImageSrc && (
    <div class="project-media">
      <img src={fallbackImageSrc} alt={work.data.title} />
    </div>
  )}
  <h3 class="project-title">{work.data.title}</h3>
  <div class="work-card-tags project-tech">
    {work.data.tags.map((t) => <span class="tag tech-tag">{t}</span>)}
  </div>
  <p class="work-card-excerpt project-summary">{excerpt}</p>
  <p class="project-detail-link">詳細を見る →</p>
</a>
