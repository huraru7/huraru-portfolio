---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { parseWorkBlocks } from '../lib/parseWorkBody';

const allWorks = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const allWorksWithBlocks = allWorks.map((work) => ({
  work,
  blocks: parseWorkBlocks(work.body ?? ''),
}));
---

<Layout
  title="All Works | huraru's Portfolio"
  description="huraru の全作品アーカイブ"
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/skill.css">
    <link rel="stylesheet" href="/css/modal.css">
    <link rel="stylesheet" href="/css/works.css">
    <link rel="stylesheet" href="/css/media.css">

    <script src="/js/dotMotion.js" defer></script>
    <script src="/js/Theme.js" defer></script>
    <script src="/js/Modal.js" defer></script>
    <script src="/js/tag-filter.js" defer></script>
  </Fragment>

  <section class="section" id="projects">
    <div class="container">
      <h2 class="section-title">ALL WORKS</h2>

      <div class="tag-filter" id="tagFilter"></div>

      <div class="project-grid" id="projectGrid">
        {allWorksWithBlocks.map(({ work, blocks }) => (
          <ProjectCard work={work} blocks={blocks} />
        ))}
      </div>
    </div>
  </section>

</Layout>
