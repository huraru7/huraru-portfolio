---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogImage?: string;
  ogUrl?: string;
  preloadImage?: string;
  isHome?: boolean;
}

const { title, description, keywords, ogImage, ogUrl, preloadImage, isHome = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script is:inline>
    (function () {
      var mode = localStorage.getItem("theme") || "night";
      if (mode === "night") document.documentElement.classList.add("night-theme");
    })();
  </script>
  <title>{title}</title>
  <meta name="description" content={description}>
  {keywords && <meta name="keywords" content={keywords}>}
  <meta name="author" content="huraru">

  {ogImage && (
    <>
      <meta property="og:image" content={ogImage}>
      <meta property="og:image:width" content="1299">
      <meta property="og:image:height" content="630">
      <meta property="og:url" content={ogUrl}>
      <meta property="og:title" content={title}>
      <meta property="og:description" content={description}>
    </>
  )}

  <link rel="preconnect" href="https://www.googletagmanager.com">
  <link rel="icon" type="image/png" href="/images/favicon.png">
  {preloadImage && <link rel="preload" as="image" href={preloadImage}>}

  <slot name="head" />

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-NQN0302N3X"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-NQN0302N3X');
  </script>
</head>

<body>
  <div class="decorative-lines">
    <div class="line"></div>
    <div class="line"></div>
    <div class="line"></div>
    <div class="line"></div>
  </div>

  <div class="dots-pattern"></div>
  <div class="barcode"></div>

  <div class="geometric-shape shape-1"></div>
  <div class="geometric-shape shape-2"></div>
  <div class="geometric-shape shape-3"></div>

  <Header isHome={isHome} />

  <slot />

  <Footer />

  <script is:inline>
    (function () {
      const footer = document.querySelector('footer');
      const actions = document.querySelector('.side-nav-actions');
      if (!footer || !actions) return;

      function updateActionsOffset() {
        const footerTop = footer.getBoundingClientRect().top;
        const overlap = Math.max(window.innerHeight - footerTop, 0);
        actions.style.transform = overlap > 0 ? `translateY(-${overlap}px)` : '';
      }

      window.addEventListener('scroll', updateActionsOffset, { passive: true });
      window.addEventListener('resize', updateActionsOffset);
      updateActionsOffset();
    })();
  </script>
</body>

</html>
