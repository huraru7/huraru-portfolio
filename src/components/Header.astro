---
import { Image } from "astro:assets";
import huraru1 from "../assets/huraru/huraru1.webp";
import aboutIcon from "../assets/images/nav/about.svg";
import worksIcon from "../assets/images/nav/works.svg";
import skillIcon from "../assets/images/nav/skill.svg";
import githubSvg from "../assets/images/skills/github.svg";
import xSvg from "../assets/images/x.svg";

interface Props {
	isHome?: boolean;
}

const { isHome = false } = Astro.props;
const home = isHome ? "" : "/index.html";
---

<aside class="side-nav" id="sideNav">
	<a href={isHome ? "#top" : "/index.html"} class="side-nav-logo" aria-label="TOPへ戻る">
		<Image src={huraru1} alt="huraru" />
	</a>

	<nav class="side-nav-menu">
		<ul>
			<li>
				<a href={`${home}#about`}>
					<span class="side-nav-icon"><Image src={aboutIcon} alt="" /></span>
					<span class="side-nav-label">ABOUT</span>
				</a>
			</li>
			<li>
				<a href={`${home}#featured-works`}>
					<span class="side-nav-icon"><Image src={worksIcon} alt="" /></span>
					<span class="side-nav-label">WORKS</span>
				</a>
			</li>
			<li>
				<a href={`${home}#skill`}>
					<span class="side-nav-icon"><Image src={skillIcon} alt="" /></span>
					<span class="side-nav-label">SKILL</span>
				</a>
			</li>
		</ul>
	</nav>

	<div class="side-nav-actions">
		<a href="https://github.com/huraru7" target="_blank" rel="noopener noreferrer">
			<span class="side-nav-icon"><Image src={githubSvg} alt="" /></span>
			<span class="side-nav-label">GitHub</span>
		</a>
		<a href="https://x.com/hurarunium_sabu" target="_blank" rel="noopener noreferrer">
			<span class="side-nav-icon"><Image src={xSvg} alt="" /></span>
			<span class="side-nav-label">X</span>
		</a>
		<button id="theme-toggle" class="theme-toggle">
			<span class="theme-toggle-visual">
				<span class="icon sun">☀</span>
				<span class="icon moon">🌙</span>
			</span>
			<span class="side-nav-label">Theme</span>
		</button>
	</div>
</aside>
