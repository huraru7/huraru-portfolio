---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="All Works | huraru's Portfolio"
  description="huraru の全作品アーカイブ"
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/skill.css">
    <link rel="stylesheet" href="/css/modal.css">
    <link rel="stylesheet" href="/css/works.css">
    <link rel="stylesheet" href="/css/media.css">

    <script src="/js/vendor/marked.min.js" defer></script>
    <script src="/js/Sunrise_Sunset.js" defer></script>
    <script src="/js/Theme.js" defer></script>
    <script src="/js/Modal.js" defer></script>
    <script src="/js/work-parser.js" defer></script>
    <script src="/js/work-renderer.js" defer></script>
    <script src="/js/works-app.js" defer></script>
  </Fragment>

  <header>
    <nav>
      <a href="index.html" class="logo">PORTFOLIO</a>
      <ul class="nav-links" id="navLinks">
        <li><a href="index.html">TOP</a></li>
        <li><a href="index.html#about">ABOUT</a></li>
        <li><a href="index.html#featured-works">WORKS</a></li>
        <li><a href="index.html#skill">SKILL</a></li>
      </ul>
      <div class="nav-actions">
        <button class="hamburger" id="hamburger" aria-label="メニューを開く">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
        <button id="theme-toggle" class="theme-toggle">
          <span class="icon sun">☀</span>
          <span class="icon moon">🌙</span>
        </button>
      </div>
    </nav>
  </header>

  <section class="section" id="projects">
    <div class="container">
      <h2 class="section-title">ALL WORKS</h2>

      <div class="tag-filter" id="tagFilter"></div>

      <div class="project-grid" id="projectGrid"></div>
    </div>
  </section>

  <footer id="contact">
    <p class="footer-text">
      CONTACT: <span class="footer-email">hurarunium@gmail.com</span>
    </p>
    <p class="footer-copyright">
      2025 this portfolio is designed by huraru.
    </p>
  </footer>

  <div id="work-modal" class="work-modal">
    <div class="work-modal-inner">
      <button class="work-modal-close" onclick="closeWorkModal()">×</button>
      <h2 class="p-title"></h2>
      <div class="p-tags"></div>
      <div class="p-body"></div>
    </div>
  </div>
</Layout>
